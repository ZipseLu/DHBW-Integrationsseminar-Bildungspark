# =============================================================================
# Umgebungsvariablen – Bildungspark Monorepo
#
# Kopieren:   cp .env.example .env
# Diese Datei wird NICHT eingecheckt.
# =============================================================================

# --- Ports (Host-Seite) -------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=8080
BACKEND_PORT=3000
MYSQL_PORT=3307
MOCKUP_PORT=8443

# --- URLs fuer den BROWSER (nicht docker-interne Namen!) ---------------------
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Vite-Dev-Server: 'true' erlaubt Zugriff ueber LAN-IP (fuer Teamarbeit noetig,
# da Vite sonst Host-Header blockiert). Bei Unsicherheit auf 'false' setzen.
VITE_ALLOWED_HOSTS=true

# --- MySQL -------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root-dev
MYSQL_DATABASE=bildungspark
MYSQL_TEST_DATABASE=bildungspark_test
MYSQL_USER=bildungspark
MYSQL_PASSWORD=bildungspark-dev

# --- Backend ohne Docker (`npm run dev` in apps/backend) ----------------------
# Das Backend nimmt DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD; fehlen sie, greifen
# die MYSQL_*-Werte oben mit MYSQL_PORT als Host-Port des Compose-Dienstes `db`.
# Mit `docker compose up -d db` ist also nichts weiter einzutragen.
# Eigene MySQL ohne Docker: DB_HOST=127.0.0.1 und DB_PORT=3306 setzen.
#DB_HOST=127.0.0.1
#DB_PORT=3306

# --- Backend / Auth (noch ungenutzt: Anmeldung ist nicht umgesetzt) ---------
JWT_SECRET=dev-secret-bitte-aendern

# --- KI-Provider -------------------------------------------------------------
# AI_PROVIDER=gemini | azure
AI_PROVIDER=gemini

# Gemini (Anfangsphase) – Key kostenlos in Google AI Studio: https://aistudio.google.com/apikey
# Diese Datei gilt fuer Docker UND fuer `npm run dev` ohne Docker (das Backend liest sie selbst).
# Optional: apps/backend/.env mit denselben Variablen – sie hat Vorrang, wenn beide existieren.
GEMINI_API_KEY=
# Stand 22.10.2026: gemini-2.5-flash ist fuer neue Keys nicht mehr verfuegbar (404).
# gemini-3.5-flash hat im Test funktioniert; bei 503 (ueberlastet) wechselt das Backend
# einmalig auf GEMINI_FALLBACK_MODEL.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Zeitlimit eines Generierungsauftrags in Millisekunden (inkl. Wiederholungsversuch)
AI_TIMEOUT_MS=60000

# Azure OpenAI (spaetere Phase)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Web-Suche nach Arbeitsblättern im Internet ------------------------------
# WEB_SEARCH_PROVIDER=scrape | mock   (Standard: scrape, kein API-Key nötig)
# scrape: echte Suche über DuckDuckGo (kein Key, kein Cloud-Konto) – nur für die Demo,
#         das Scraping von Yahoo/Bing ist laut deren Nutzungsbedingungen nicht erlaubt.
# mock:   simulierte Platzhalter (ohne Internet, nur für die lokale Entwicklung)
WEB_SEARCH_PROVIDER=scrape
# Maximal zurückgegebene Treffer pro Anfrage (Standard: 10)
WEB_SEARCH_MAX_RESULTS=10
# Zeitlimit eines einzelnen Anbieters in Millisekunden (Standard: 15000)
WEB_SEARCH_TIMEOUT_MS=15000
# Gesamtzeitlimit über alle Anbieter hinweg (Standard: 20000)
WEB_SEARCH_TOTAL_TIMEOUT_MS=20000
# Rate-Limit pro Client-IP, solange die Route noch keine Anmeldung verlangt
WEB_SEARCH_RATE_LIMIT_MAX=30
WEB_SEARCH_RATE_LIMIT_WINDOW_MS=60000
# Für den späteren Betrieb beim Bildungspark: offizielle Such-API statt Scraping,
# z. B. SerpAPI (die Umstellung ist noch nicht implementiert).
#WEB_SEARCH_API_KEY=

# --- Playwright --------------------------------------------------------------
PWDEBUG=0
