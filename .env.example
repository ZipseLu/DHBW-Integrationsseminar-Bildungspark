# =============================================================================
# Umgebungsvariablen fuer docker compose
#
# Kopieren:  cp .env.example .env
# Die Datei .env wird NICHT eingecheckt (siehe .gitignore).
# =============================================================================

# --- Ports (Host-Seite) -------------------------------------------------------
FRONTEND_PORT=8443
FRONTEND_PROD_PORT=8080
BACKEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- URLs, die der BROWSER verwendet (nicht docker-interne Namen!) -----------
PUBLIC_FRONTEND_URL=http://localhost:8443
PUBLIC_API_URL=http://localhost:3001/api

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bildungspark

# --- Backend / Auth ----------------------------------------------------------
# Fuer den Prototyp reicht ein beliebiger String. In Produktion zufaellig generieren:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-bitte-in-prod-aendern

# --- KI-Anbieter (Backend) ---------------------------------------------------
OPENAI_API_KEY=
# Alternatives Modell, z.B. claude-sonnet-4-5
OPENAI_MODEL=gpt-4o

# --- Web-Suche fuer die KI-Recherche (BE-AI-04) ------------------------------
SERPAPI_API_KEY=
